# Copy to .env and fill in — all values are placeholders.

# environment
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:5173

# database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
DB_POOL_PRE_PING=false
DB_POOL_RECYCLE_SECONDS=0

# secrets
SECRET_KEY=change-me
ENCRYPTION_KEY=change-me
SESSION_TTL_SECONDS=900

# adapters
VECTOR_BACKEND=memory
QUEUE_BACKEND=inline
CACHE_BACKEND=memory
STORAGE_BACKEND=local
EMBEDDING_BACKEND=fake
RERANK_BACKEND=none
LLM_BACKEND=gemini
OCR_BACKEND=paddleocr_hosted

# web search
WEB_SEARCH_BACKEND=none
TAVILY_API_KEY=

# vector store
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=chunks

# cache
REDIS_URL=
REDIS_TOKEN=

# storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=documents
LOCAL_STORAGE_DIR=./data/storage

# queue
QSTASH_URL=https://qstash.upstash.io/v2
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
PUBLIC_BASE_URL=http://localhost:8000

# providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
JINA_API_KEY=
COHERE_API_KEY=

# ocr
OCR_BACKENDS=paddleocr_hosted,gemini
OCR_VISION_MODEL=gemini-3.8-flash
PADDLEOCR_API_KEY=
PADDLEOCR_BASE_URL=

# models
DEFAULT_LLM_MODEL=gemini-3.8-flash
UTILITY_LLM_MODEL=

# whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_MAX_MESSAGE_LENGTH=3500
WHATSAPP_LOCK_TTL_SECONDS=120
WHATSAPP_LOCK_WAIT_SECONDS=10.0
WHATSAPP_WINDOW_CACHE_TTL_SECONDS=30
WHATSAPP_APP_ID=
WHATSAPP_CONFIG_ID=

# google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/login

# public surface
DASHBOARD_URL=
PRODUCT_NAME=kado

# telemetry
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ingest limits
MAX_UPLOAD_BYTES=26214400
UPLOAD_READ_CHUNK_BYTES=1048576
MAX_DOCUMENT_PAGES=2000
EMBED_BATCH_SIZE=32

# outbound http
HTTP_TIMEOUT_SECONDS=30.0
ANSWER_CACHE_TTL_SECONDS=0
CIRCUIT_FAIL_MAX=3
CIRCUIT_RESET_SECONDS=30

# url fetch
URL_FETCH_ALLOW_PRIVATE=false
URL_FETCH_ALLOWED_PORTS=80,443
URL_FETCH_MAX_REDIRECTS=3
URL_RECRAWL_DEFAULT_HOURS=0
URL_RECRAWL_BATCH=20

# website crawl
CRAWL_ENABLED=true
CRAWL_WAVE_CONCURRENCY=4
CRAWL_WAVE_BUDGET_SECONDS=20
CRAWL_TOTAL_BUDGET_SECONDS=86400
CRAWL_DEFAULT_DELAY_MS=500
CRAWL_MIN_DELAY_MS=200
CRAWL_MAX_DELAY_MS=30000
CRAWL_MAX_PAGE_BYTES=5242880
CRAWL_FETCH_TIMEOUT_SECONDS=20.0
CRAWL_USER_AGENT=
CRAWL_RESPECT_ROBOTS=true
CRAWL_SITEMAP_MAX_DEPTH=3
CRAWL_SITEMAP_MAX_URLS=50000
CRAWL_MAX_PDFS_PER_SOURCE=20
CRAWL_SIMHASH_MAX_DISTANCE=3
CRAWL_MIN_TEXT_CHARS=120
CRAWL_MAX_DEPTH=5
CRAWL_LINK_CLAIM_TTL_SECONDS=300
CRAWL_STALL_TTL_SECONDS=600
CRAWL_RENDER_BACKEND=none
CRAWL_RENDER_URL=
CRAWL_RENDER_API_KEY=
CRAWL_MAX_RENDERS_PER_SOURCE=50
CRAWL_BROWSER_CONCURRENCY=8
CRAWL_EXTRACT_CONCURRENCY=8
SOURCE_RETRAIN_PER_HOUR=6

# ingest batching
INGEST_BATCH_DOCS=8
INGEST_DOC_CONCURRENCY=4

# actions
ACTIONS_ENABLED=false
ACTIONS_MAX_ITERATIONS=5
ACTIONS_TIMEOUT_SECONDS=10
ACTIONS_TOTAL_BUDGET_SECONDS=25
ACTIONS_MAX_RESPONSE_BYTES=65536
ACTIONS_ALLOWED_PORTS=443
ACTIONS_USER_AGENT=ContextAgent-Actions/1.0
ACTIONS_CLIENT_SUSPENSION_TTL_SECONDS=300
ACTIONS_CONFIRMATION_TTL_SECONDS=900
ACTION_CALLS_RETENTION_DAYS=90

# procedures
PROCEDURES_ENABLED=false
PROCEDURE_MAX_STEPS=15
PROCEDURE_MAX_BRANCHES=5
PROCEDURE_MAX_BRANCH_DEPTH=1
PROCEDURE_TRIGGER_MAX_LENGTH=400
PROCEDURE_TRIGGER_MAX_INJECTED=12
PROCEDURE_SHORTLIST_MODE=none
PROCEDURE_MAX_TURNS=25
PROCEDURE_MAX_ACTION_CALLS=12
PROCEDURE_MAX_BOOKKEEPING_CALLS=4
PROCEDURE_MAX_RESTARTS=3
PROCEDURE_RUN_TTL_SECONDS=172800
PROCEDURE_RUNS_RETENTION_DAYS=400

# identity
IDENTITY_VERIFICATION_ENABLED=false
IDENTITY_MAX_TTL_SECONDS=300
IDENTITY_CLOCK_SKEW_SECONDS=60
IDENTITY_MAX_ATTRIBUTES=20
IDENTITY_JTI_LEDGER_RETENTION_SECONDS=900

# contacts
CONTACT_MAX_ATTRIBUTES=25
CONTACT_ATTRIBUTE_MAX_LENGTH=200

# escalation
ESCALATION_DEFAULT_HOURLY_CAP=20
ESCALATION_RETENTION_DAYS=400
ESCALATION_NOTIFY_TIMEOUT_SECONDS=10
SLACK_ENABLED=false

# email channel
EMAIL_BACKEND=none
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_INBOUND_DOMAIN=resend.dev
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Agent Support
EMAIL_MAX_BODY_CHARS=8000
EMAIL_MAX_REPLY_CHARS=20000
EMAIL_ATTACHMENT_MAX_BYTES=10485760
EMAIL_LOCK_TTL_SECONDS=180
EMAIL_LOCK_WAIT_SECONDS=15
EMAIL_MAX_REPLIES_PER_THREAD=3
EMAIL_THREAD_WINDOW_HOURS=72
EMAIL_RECEIPT_RETENTION_DAYS=90

# growth research providers
APOLLO_API_KEY=
HUNTER_API_KEY=
EMAIL_VERIFIER_BACKEND=none
EMAIL_VERIFIER_API_KEY=

# growth platform
GROWTH_ENABLED=false
